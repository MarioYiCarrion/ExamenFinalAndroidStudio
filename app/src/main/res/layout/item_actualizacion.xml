<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cvHistorialActualizaciones"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F5F5F5"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/frameLayoutFecha"
            android:layout_width="120dp"
            android:layout_height="0dp"
            android:background="@drawable/border_background"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvFechaActualizacion"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:drawableStart="@drawable/baseline_date_range_24"
                android:drawableTint="#1E88E5"
                android:gravity="center"
                android:text="Fecha de Actualización"
                android:textAlignment="center"
                android:textSize="16sp"
                android:textStyle="bold" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/frameLayoutTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/border_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/frameLayoutFecha"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvTituloActualizacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/diario"
                android:drawableTint="#1E88E5"
                android:text="Título de la Actualización"
                android:textSize="14sp"
                android:textStyle="bold" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/frameLayoutDescripcion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/border_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/frameLayoutFecha"
            app:layout_constraintTop_toBottomOf="@+id/frameLayoutTitulo">

            <TextView
                android:id="@+id/tvDescripcionActualizacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/baseline_display_settings_24"
                android:drawableTint="#1E88E5"
                android:text="Descripción de la Actualización"
                android:textSize="12sp"
                android:textStyle="italic" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
